    <Component class="javax.swing.JLabel" name="lbd">
      <Properties>
        <Property name="horizontalAlignment" type="int" value="0"/>
        <Property name="text" type="java.lang.String" value="&lt;html&gt;Abdolhashem Management System&lt;br&gt;&#xa;Abdolhashem Management System is a modern and user-friendly application designed to simplify and organize daily management tasks. It allows administrators to manage students, employees, rooms, payments, salaries, costs, and users from one centralized system.&lt;br&gt;&#xa;The dashboard provides a clear overview of important information, while features such as notifications, user management, settings, and Light/Dark Mode make the system easier and more efficient to use.&lt;br&gt;&#xa;The main goal is to provide a simple, organized, and efficient platform for managing all important records and daily activities in one place&lt;/html&gt;"/>
      </Properties>
    </Component>
